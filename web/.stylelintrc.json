{
  "extends": "stylelint-config-standard",
  "rules": {
    "selector-type-no-unknown": [true, { "ignoreTypes": ["/^ears-/"] }],
    "selector-pseudo-class-no-unknown": [true, { "ignorePseudoClasses": ["host", "host-context"] }],
    "font-family-name-quotes": "always-where-recommended",
    "property-no-vendor-prefix": [true, { "ignoreProperties": ["text-stroke", "tap-highlight-color"] }],
    "no-descending-specificity": null
  }
}
