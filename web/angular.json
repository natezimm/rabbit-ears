{
  "version": 1,
  "cli": {
    "analytics": false
  },
  "projects": {
    "rabbitears": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "ears",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.json",
            "index": "src/index.html",
            "styles": ["src/styles.css"],
            "assets": [{ "glob": "**/*", "input": "public" }],
            "outputPath": {
              "base": "../src/RabbitEars.Api/wwwroot",
              "browser": ""
            }
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": { "minify": true, "inlineCritical": false },
                "fonts": true
              }
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": { "buildTarget": "rabbitears:build:production" },
            "development": { "buildTarget": "rabbitears:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
