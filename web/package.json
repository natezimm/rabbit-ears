{
  "name": "rabbitears",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "ng serve --host 127.0.0.1 --port 4200",
    "build": "ng build",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "format": "prettier --write . && stylelint --fix \"src/**/*.css\"",
    "format:check": "prettier --check .",
    "test:browser": "npm run build && dotnet build ../src/RabbitEars.Api -c Release && tsc -p e2e/tsconfig.json && playwright test"
  },
  "dependencies": {
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/router": "22.2.5",
    "@microsoft/signalr": "11.0.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "angular-eslint": "22.6.0",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "engines": {
    "node": "26.x"
  }
}
