# Rabbit Ears settings for this machine. Installed to /etc/rabbitears/box.env
# and never overwritten by an update. After editing:
#   sudo systemctl restart rabbitears
#
# Any setting in appsettings.json can be set here: join the names with two
# underscores, e.g. "Box": { "Picture": { "Transition": ... } } becomes
# Box__Picture__Transition.

ASPNETCORE_ENVIRONMENT=Production

# Optional: send traces, metrics and logs somewhere over OpenTelemetry, such as
# Grafana Cloud's free tier (docs/observability.md). Nothing is sent without it.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64 of instance id:token>
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
Box__MediaRoot=/srv/rabbitears/media
Box__StateDir=/var/lib/rabbitears

# Resume = a channel picks up where you left it. Random = every flip starts a
# fresh shuffled episode a few seconds in.
Box__Tv__TuneIn=Resume

# What draws the TV: mpv plays the shows as they are, any format. "browser" is
# the old /tv page in Chromium, which only plays MP4. Applies at the next login.
Box__Player__Kind=mpv

# Channel-change effect: none, static (analog snow) or glitch.
Box__Picture__Transition=none

# Volume-down once more at 0 says GOODBYE and shuts the box down cleanly, so it
# is safe to pull the plug. Turn it back on by plugging the power in.
Box__Tv__PowerOffAtZeroVolume=true
Box__PowerOffCommand__0=sudo
Box__PowerOffCommand__1=systemctl
Box__PowerOffCommand__2=poweroff
