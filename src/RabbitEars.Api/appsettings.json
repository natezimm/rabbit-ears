{
  "Urls": "http://0.0.0.0:5080",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Box": {
    "MediaRoot": "/srv/rabbitears/media",
    "StateDir": "/var/lib/rabbitears",
    "FirstChannelNumber": 2,
    "RescanMinutes": 10,
    "PowerOffCommand": [],
    "Player": {
      "Kind": "mpv",
      "MpvSocket": "/run/rabbitears-tv/mpv.sock"
    },
    "Tv": {
      "TuneIn": "Live",
      "StartOffsetMin": 6,
      "StartOffsetMax": 10,
      "StartChannel": 2,
      "InitialVolume": 60,
      "VolumeStep": 5,
      "PowerOffAtZeroVolume": false,
      "DigitEntrySeconds": 2
    },
    "Picture": {
      "Transition": "none",
      "TransitionSeconds": 0.4,
      "BridgeSeconds": 0.8,
      "BannerSeconds": 4,
      "OsdSeconds": 2,
      "Crt": {
        "Enabled": true,
        "Curvature": 0.15,
        "CornerRadius": 0.05,
        "Vignette": 0.3,
        "Scanlines": true,
        "ScanlineIntensity": 0.1
      },
      "Osd": {
        "Color": "#3DFF6E",
        "Glow": true
      }
    }
  }
}
